generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum ExtractedStatus {
  PENDING
  PROCESSING
  EXTRACTED
  FAILED
}

model Document {
  id              String          @id @default(cuid())
  filename        String
  r2key           String          @unique
  size            Int
  mimetype        String
  uploadStatus    UploadStatus    @default(PENDING)
  extractedStatus ExtractedStatus @default(PENDING)
  extractedText   String?         @db.Text
  extractionError String?
  createdAt       DateTime        @default(now())

  @@index([extractedStatus])
}
